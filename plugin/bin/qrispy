#!/usr/bin/env python3
"""qrispy — the one command of the qrispy kit (RAL ticket 090). It finds the kit from its own real path (it may be
a symlink in ~/.local/bin) and runs the tool for the subcommand; the tools find the repository from the working folder.

    qrispy ls | show | inbox | cite | lint | questions | dashboard ...   tickets (lib/qrispy.py)
    qrispy job run <dir> ... | wait <dir> ... | status <dir> ... | handled <dir> "<what was done>"   long-running work
    qrispy review freeze | record | start | finish ...                     review rounds (lib/jobs/review_headless.sh)
    qrispy worker prompt | claude-bg | headless | tmux | result | watch | away | whoami | status ...   (lib/launch.py)
    qrispy lock status | take | hold | note | release ...                 the machine's GPU lock (lib/gpu_lock.py)
    qrispy check-response <revN.md> <revN_response.md>                    review response format (lib/check_response.py)
    qrispy config repo | ticket-dir | primary-root | review-scratch | external-roots   (lib/qrispy_config.py)
"""
import os
import sys

LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
PY = {"worker": "launch.py", "lock": "gpu_lock.py", "check-response": "check_response.py", "config": "qrispy_config.py"}
JOB = {"run": "run_job.sh", "wait": "wait_job.sh", "status": "job_status.sh"}


def run(argv):
    os.execvp(argv[0], argv)


def main(args):
    cmd, rest = (args[0], args[1:]) if args else ("", [])
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    if cmd in PY:
        run([sys.executable, "-B", os.path.join(LIB, PY[cmd])] + rest)
    if cmd == "job":
        sub, more = (rest[0], rest[1:]) if rest else ("", [])
        if sub == "handled":
            run(["bash", os.path.join(LIB, "jobs", "run_job.sh"), "--handled"] + more)
        if sub in JOB:
            run(["bash", os.path.join(LIB, "jobs", JOB[sub])] + more)
        sys.exit("usage: qrispy job run|wait|status|handled ...")
    if cmd == "review":
        run(["bash", os.path.join(LIB, "jobs", "review_headless.sh")] + rest)
    run([sys.executable, "-B", os.path.join(LIB, "qrispy.py")] + args)


if __name__ == "__main__":
    main(sys.argv[1:])
